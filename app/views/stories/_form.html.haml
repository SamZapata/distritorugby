= form_with model: @story, scope: :story, url: (@story.persisted? ? story_path(@story) : stories_path) do |form|
  - if @story.errors.any?
    %div{role: 'alert'}
      %h2= 'No se pudo guardar la historia:'
      %ul
        - @story.errors.full_messages.each do |message|
          %li= message

  %p
    = form.label :name, 'Nombre'
    = form.text_field :name, required: true

  %p
    = form.label :summary, 'Resumen'
    = form.text_area :summary, required: true

  %p
    = form.label :body, 'Contenido'
    = form.text_area :body, required: true

  %p
    = form.label :image_caption, 'Pie de imagen'
    = form.text_field :image_caption, required: true

  %p
    = form.label :image, 'Imagen'
    = form.file_field :image

  = form.submit 'Guardar'
