= form_with model: @team, scope: :game_nn_team, url: (@team.persisted? ? game_nn_team_path(@team) : game_nn_teams_path) do |form|
  - if @team.errors.any?
    %div{role: 'alert'}
      %h2= 'No se pudo guardar el equipo:'
      %ul
        - @team.errors.full_messages.each do |message|
          %li= message

  %p
    = form.label :name, 'Nombre'
    = form.text_field :name, required: true

  %p
    = form.label :about, 'Descripción'
    = form.text_area :about

  = form.submit 'Guardar'
