= form_with model: @coach, scope: :game_coach, url: (@coach.persisted? ? game_coach_path(@coach) : game_coaches_path) do |form|
  - if @coach.errors.any?
    %div{role: 'alert'}
      %h2= 'No se pudo guardar el entrenador:'
      %ul
        - @coach.errors.full_messages.each do |message|
          %li= message

  %p
    = form.label :first_name, 'Nombre'
    = form.text_field :first_name, required: true

  %p
    = form.label :last_name, 'Apellido'
    = form.text_field :last_name, required: true

  %p
    = form.label :about, 'Descripción'
    = form.text_area :about

  = form.submit 'Guardar'
