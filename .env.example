# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (.gitignore lo excluye).

# --- Base de datos (PostgreSQL) ---
# Usada por docker-compose.yml y config/database.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=distritorugby_development
DATABASE_URL=postgres://postgres:password@localhost:5432/distritorugby_development

# --- Cloudinary (subida de imágenes) ---
# Requerido por config/cloudinary.yml y config/initializers/cloudinary.rb
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- SMTP (envío de correos: Devise y ActionMailer) ---
# Usado por config/environments/development.rb
SENDMAIL_USERNAME=your_smtp_user
SENDMAIL_PASSWORD=your_smtp_password

# --- Action Cable (solo producción) ---
# Usado por config/cable.yml
REDIS_URL=redis://localhost:6379/1

# --- Rails ---
# Clave maestra para credentials (solo si decides usar credentials.yml.enc;
# este proyecto está configurado para trabajar con variables de entorno).
RAILS_MASTER_KEY=

# UID/GID del contenedor web (docker-compose). Por defecto 1000:1000; cámbialo
# si tu usuario del host tiene otro id (`id -u` / `id -g`) para que los archivos
# de tmp/, log/ y storage/ no queden con dueño root.
APP_UID=1000
APP_GID=1000

# RAILS_ENV=development
# RAILS_MAX_THREADS=5
# PORT=3000
